# --- Required -------------------------------------------------------------
# Comma-separated bot tokens from @BotFather. Every bot must be an admin of the
# channel below with "Post messages", "Delete messages" and "Pin messages".
TGV_BOT_TOKENS=123456:AAAA...,234567:BBBB...
# Private channel id (starts with -100). Forward a channel post to @userinfobot to see it.
TGV_CHAT_ID=-1001234567890
# Generate both with:  tgvault gen-secrets
TGV_MASTER_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
TGV_SERVER_SECRET=REPLACE_WITH_ANOTHER_BASE64_32_BYTES
# Panel login. Or set TGV_ADMIN_PASSWORD_HASH from `tgvault hash-password`.
TGV_ADMIN_PASSWORD=change-me-to-something-long

# --- Network --------------------------------------------------------------
TGV_BIND=127.0.0.1:8787
# The URL people use; an https:// URL also turns on Secure cookies and HSTS.
TGV_PUBLIC_URL=https://vault.example.com
# Only behind a reverse proxy that sets X-Forwarded-For (the last hop is used).
TGV_TRUST_PROXY=false

# --- Storage --------------------------------------------------------------
TGV_DATA_DIR=./data
TGV_BACKEND=telegram            # telegram | local (local = directory, for testing)
TGV_CHUNK_MIB=16                # <= 19 for the public Bot API (20 MB download cap)
# Self-hosted telegram-bot-api server lifts limits to 2000 MB per file:
# TGV_TG_API_BASE=http://127.0.0.1:8081
# TGV_TG_LOCAL_MODE=true
# TGV_CHUNK_MIB=512
TGV_MAX_UPLOAD_GIB=64
TGV_UPLOAD_CONCURRENCY=4
TGV_CACHE_MIB=256
TGV_TRASH_DAYS=30
TGV_BACKUP_INTERVAL_HOURS=6

# --- Limits ---------------------------------------------------------------
TGV_DEFAULT_KEY_RPM=600
TGV_PUBLIC_RPM=300
TGV_SESSION_HOURS=12
# Key rotation: add a version and switch to it, then POST /api/v1/admin/rewrap
# TGV_MASTER_KEYS=1:old...,2:new...
# TGV_ACTIVE_KEY=2
